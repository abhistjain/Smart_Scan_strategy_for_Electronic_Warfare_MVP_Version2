# --- Hugging Face access for the TSRD dataset (Real Data mode) --------------
# Only required if you want to build the REAL TSRD cache with:
#     python backend/data/prepare_tsrd_cache.py --real
#
# 1. Create a free account at https://huggingface.co
# 2. Accept the dataset access terms at:
#    https://huggingface.co/datasets/alan-turing-institute/turing-synthetic-radar-dataset
# 3. Create a read token at https://huggingface.co/settings/tokens
# 4. Set it here (or export it in your shell). NEVER commit your real token.
HF_TOKEN=hf_your_token_here

# --- Anthropic Claude API (AI Analyst layer, v3 add-on) ---------------------
# OPTIONAL. The whole app runs fully without this - AI narration/chat/summary
# panels simply show "AI narration unavailable". NEVER commit a real key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Small, fast model is plenty for narration/summarisation (not the core algo).
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Frontend -> backend wiring (optional; sensible defaults are built in) ---
# HTTP base used by Next.js rewrites for /api/*
NEXT_PUBLIC_BACKEND_HTTP=http://127.0.0.1:8000
# WebSocket base used by the dashboard live stream
NEXT_PUBLIC_BACKEND_WS=ws://127.0.0.1:8000
